from math import *
x = float(input("Enter a value for x: "))


if  (0 < x) and (x <= 2) :
    tolerance = float(input("Enter the tolerance: "))
    exact_ln = log(x)
    other_ln= 0.0
    x1 = 1.0
    term = (x -1 )** x1/ x1
    while abs(term) >= tolerance:
        if x1 % 2 == 1:
            other_ln += term
        else:
            other_ln -= term
        x1 +=1
        term= ((x-1)**x1)/x1
    print(f"ln({x}) is approximately {other_ln}")
    print(f"ln({x}) is exactly {exact_ln}")
    diff = other_ln - exact_ln
    print(f"The difference is {diff}")
else: 
    while x<=0 or x > 2:
