from math import*

quantity = float(input("Please enter the quantity to be converted: "))
Newtons = quantity* 4.44822
print(f"{quantity:.2f} pounds force is equivalent to {Newtons:.2f} newtons")
Feet = quantity*3.28084
print(f"{quantity:.2f} meters is equivalent to {Feet:.2f} feet")
kPA = quantity * 101.325 
print(f"{quantity:.2f} atmospheres is equivalent to {kPA:.2f} kilopascals")
Btu = quantity*  3.41214163 
print(f"{quantity:.2f} watts is equivalent to {Btu:.2f} BTU per hour")
Gal_min=  (0.264172052 * quantity)*60
print(f"{quantity:.2f} liters per second is equivalent to {Gal_min:.2f} US gallons per minute")
Farenheit = (quantity*(9/5))+32
print(f"{quantity:.2f} degrees Celsius is equivalent to {Farenheit:.2f} degrees Fahrenheit")
